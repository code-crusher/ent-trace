+package entpb
+
+import (
+	"testing"
+
+	"entgo.io/contrib/entproto/internal/bare/ent"
+	"github.com/stretchr/testify/require"
+)
+
+// TestToProtoGeneratedForMessage verifies that the ent -> proto conversion
+// functions are generated for schemas annotated with entproto.Message(),
+// without requiring the entproto.Service() annotation (issue ent/ent#4410).
+func TestToProtoGeneratedForMessage(t *testing.T) {
+	u := &ent.User{
+		ID:           1,
+		Name:         "a8m",
+		EmailAddress: "a8m@ent.io",
+	}
+	pb, err := toProtoUser(u)
+	require.NoError(t, err)
+	require.Equal(t, int64(1), pb.GetId())
+	require.Equal(t, "a8m", pb.GetName())
+	require.Equal(t, "a8m@ent.io", pb.GetEmailAddress())
+
+	pbs, err := toProtoUserList([]*ent.User{u})
+	require.NoError(t, err)
+	require.Len(t, pbs, 1)
+	require.Equal(t, "a8m", pbs[0].GetName())
+}
