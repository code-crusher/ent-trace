+
+// TestSensitiveFieldExcluded verifies that fields marked as Sensitive are not
+// exposed in the generated protobuf message nor copied by the generated
+// conversion functions (issue ent/ent#4410).
+func TestSensitiveFieldExcluded(t *testing.T) {
+	u := &ent.User{
+		ID:       1,
+		Name:     "a8m",
+		Password: "not-a-secret",
+	}
+	pb, err := toProtoUser(u)
+	require.NoError(t, err)
+	require.Equal(t, int64(1), pb.GetId())
+	require.Equal(t, "a8m", pb.GetName())
+
+	// The sensitive field must not be mapped to the pb message.
+	fields := pb.ProtoReflect().Descriptor().Fields()
+	names := make([]string, 0, fields.Len())
+	for i := 0; i < fields.Len(); i++ {
+		names = append(names, string(fields.Get(i).Name()))
+	}
+	require.ElementsMatch(t, []string{"id", "name"}, names)
+
+	// The value must not leak through serialization either.
+	b, err := proto.Marshal(pb)
+	require.NoError(t, err)
+	require.NotContains(t, string(b), "not-a-secret")
+}
